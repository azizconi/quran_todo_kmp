<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup and device-to-device transfer for Android 12 and newer (android:dataExtractionRules).
  The same whitelist goes to the Google account backup (cloud-backup) and to a new phone set up from an
  old one (device-transfer): the Room database quran_todo.db with its write-ahead log and the
  SharedPreferences, except the per-installation files of Firebase and Google Play services. Nothing
  else: not filesDir, not the caches and not the downloaded audio (noBackupFilesDir).
  Keep this file in sync with backup_rules.xml (Android 11 and older) and docs/RELEASE.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="quran_todo.db" />
        <include domain="database" path="quran_todo.db-wal" />
        <include domain="sharedpref" path="." />

        <exclude domain="sharedpref" path="com.google.android.gms.measurement.prefs.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="FirebaseAppHeartBeat.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="quran_todo.db" />
        <include domain="database" path="quran_todo.db-wal" />
        <include domain="sharedpref" path="." />

        <exclude domain="sharedpref" path="com.google.android.gms.measurement.prefs.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="FirebaseAppHeartBeat.xml" />
    </device-transfer>
</data-extraction-rules>
