{
  "sourceLanguage": "en",
  "strings": {
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the progress report image to your Photos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет изображение отчёта о прогрессе в «Фото»."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тасвири ҳисоботи пешрафтро ба «Акс»-ҳои шумо захира мекунад."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Taraqqiyot hisoboti rasmini «Rasmlar»ga saqlaydi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme raporu görselini Fotoğraflar'a kaydeder."
          }
        }
      }
    }
  },
  "version": "1.0"
}
